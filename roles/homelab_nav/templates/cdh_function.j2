# System-wide 'cdh' navigation function
# Managed by Ansible - homelab_nav role

cdh() {
    # Jinja2 injects the base repository path dynamically at deployment.
    # The $(hostname) command automatically resolves the current node's name.
    # 
    # ${1:-} means:
    # - Take the first argument provided (e.g., 'pihole')
    # - If no argument is provided, default to nothing (meaning it just 
    #   drops you into the root $(hostname) folder).
    cd "{{ docker_homelab_dest }}/servers/$(hostname)/${1:-}"
}
