# {{ inventory_hostname }} - managed by Ansible, do not edit by hand
#
# script_user + enable_script_security restrict the scripts keepalived
# calls (check + notify) to run as admin_user rather than root, since
# keepalived itself must run as root for VRRP/VIP management but the
# scripts it shells out to don't need that privilege.

global_defs {
      script_user {{ admin_user }}
      enable_script_security
      max_auto_priority 99
}

# Self-check used by VRRP to decide if THIS node is healthy enough to hold
# the VIP. Runs with no target argument, so check.sh.j2 defaults to 127.0.0.1.
vrrp_script chk_service {
        script "{{ keepalived_check_script }}"
        interval {{ keepalived_check_interval }}
        timeout {{ keepalived_check_timeout }}
        fall {{ keepalived_check_fall }}
        rise {{ keepalived_check_rise }}
}

vrrp_instance {{ keepalived_instance_name }} {
    state {{ keepalived_state }}
    interface {{ keepalived_interface }}
    virtual_router_id {{ keepalived_virtual_router_id }}
    priority {{ keepalived_priority }}
    advert_int 1
    unicast_src_ip {{ keepalived_unicast_src_ip }}
    unicast_peer {
{% for peer in keepalived_unicast_peers %}
        {{ peer }}
{% endfor %}
    }
    virtual_ipaddress {
        {{ keepalived_vip }}
    }
    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }
    track_script {
        chk_service
    }
    notify {{ keepalived_notify_script }}
}

{% if keepalived_load_balancer_enabled | bool %}
# --- IPVS load balancing -----------------------------------------------
# NOTE: fwmark-based virtual services, not IP:port ones.
#
# keepalived normally runs its own virtual_server on every node that has
# one configured, regardless of that node's VRRP state - meaning both
# nodes would act as IPVS director simultaneously for the same VIP. In
# LVS-DR mode a packet one director forwards to the other is still
# addressed to the VIP (DR mode never rewrites the IP header, only the
# destination MAC), so the receiving node's own IPVS instance intercepts
# it a second time and can reschedule it straight back - an unbounded
# MAC-layer ping-pong loop (confirmed by direct testing: DR mode never
# decrements TTL, so nothing kills the loop on its own once it starts).
#
# The fix is a firewall mark rather than disabling either node's IPVS:
# an iptables mangle rule (see tasks/main.yaml) marks VIP-destined traffic
# UNLESS its source MAC is the peer's - so only genuinely new client
# traffic gets marked, never a packet the peer already forwarded here.
# virtual_server then matches on that mark instead of the VIP/port
# directly, so a forwarded packet (unmarked on arrival) never matches this
# node's own virtual_server and never gets rescheduled. Both nodes keep
# their full MISC_CHECK health monitoring exactly as normal - this is a
# packet-marking fix, not a "disable IPVS on the passive node" one, so
# continuous per-real-server health checking is fully preserved.
#
# fwmark-based real_server entries take no port (keepalived clears it with
# a warning if one is given - the port is already implied by the mangle
# rule's own --dport match).
{% set fwmarks = {'UDP': keepalived_lb_fwmark_udp, 'TCP': keepalived_lb_fwmark_tcp} %}
{% for proto in keepalived_lb_protocols %}
# fwmark {{ fwmarks[proto] }} = {{ proto }} port {{ keepalived_lb_port }} traffic to the VIP,
# marked by the mangle rule in {{ keepalived_mangle_script }}
virtual_server fwmark {{ fwmarks[proto] }} {
    delay_loop 6
    lb_algo {{ keepalived_lb_algo }}
    lb_kind {{ keepalived_lb_kind }}

{% for rs in keepalived_real_servers %}
    real_server {{ rs.ip }} {
        weight {{ rs.weight | default(1) }}
        MISC_CHECK {
            misc_path "{{ keepalived_check_script }} {{ rs.ip }}"
            misc_timeout {{ keepalived_check_timeout }}
        }
    }
{% endfor %}
}
{% endfor %}
{% endif %}

