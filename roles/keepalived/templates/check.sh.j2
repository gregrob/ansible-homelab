#!/bin/bash
# Managed by Ansible - do not edit by hand
#
# Generic keepalived health check wrapper. The actual check command is
# supplied via keepalived_check_command, so this file never needs to
# change between services (DNS, Traefik, etc.) — only the var does.
#
# Used two ways:
#  - By keepalived's vrrp_script, checking this node's own service. Always
#    called with both args explicitly (127.0.0.1 and this node's own
#    token) rather than relying on defaults, since there's no sensible
#    default token.
#  - By keepalived's IPVS MISC_CHECK (real_server blocks), with a target
#    pool member's IP as $1 and that member's own API token as $2.
#
# keepalived_check_command must reference ${TARGET} and, if it needs
# authentication (the default Technitium API check does), ${TOKEN} - for
# this to work.

TARGET="${1:-127.0.0.1}"
TOKEN="${2:-}"

{{ keepalived_check_command }}
