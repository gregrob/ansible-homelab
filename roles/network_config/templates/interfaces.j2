# This file is managed by Ansible - do not edit manually

# This file describes the network interfaces available on your system
# and how to activate them. For more information, see interfaces(5).

source /etc/network/interfaces.d/*

# The loopback network interface
auto lo
iface lo inet loopback

{% for iface in network_interfaces_effective %}
{% if iface.vlan_id is defined %}
# VLAN {{ iface.vlan_id }} on {{ iface.parent }} - {{ iface.purpose | default('no purpose set') }}
{% else %}
# {{ iface.purpose | default('no purpose set') }}
{% endif %}
{% if iface.firewalled | default(false) %}
#
#  Firewall rules restrict this interface to allow-listed traffic only:
#   - Allows established and related connections (return traffic for active sessions)
#   - Allows inbound/outbound traffic to/from: {{ (iface.allowed_ips | default([])) | join(', ') }}
#   - Drops all other traffic on this interface
#   - Rules are applied when the interface comes up and cleaned up when it goes down
#
{% endif %}
allow-hotplug {{ iface.name }}
{% if iface.address is not defined %}
iface {{ iface.name }} inet manual
{% else %}
iface {{ iface.name }} inet static
    address {{ iface.address }}
    netmask {{ iface.netmask }}
{% endif %}
{% if iface.gateway is defined %}
    gateway {{ iface.gateway }}
{% endif %}
{% if iface.dns_nameservers is defined %}
    dns-nameservers {{ iface.dns_nameservers }}
{% endif %}
{% if iface.dns_search is defined %}
    dns-search {{ iface.dns_search }}
{% endif %}
{% if iface.vlan_id is defined %}
    vlan-raw-device {{ iface.parent }}
{% endif %}
{% if iface.firewalled | default(false) %}
    post-up iptables -A INPUT -i {{ iface.name }} -m state --state ESTABLISHED,RELATED -j ACCEPT
    post-up iptables -A OUTPUT -o {{ iface.name }} -m state --state ESTABLISHED,RELATED -j ACCEPT
{% for ip in iface.allowed_ips | default([]) %}
    post-up iptables -A INPUT -i {{ iface.name }} -s {{ ip }} -j ACCEPT
    post-up iptables -A OUTPUT -o {{ iface.name }} -d {{ ip }} -j ACCEPT
{% endfor %}
    post-up iptables -A INPUT -i {{ iface.name }} -j DROP
    post-up iptables -A OUTPUT -o {{ iface.name }} -j DROP
{% for ip in iface.allowed_ips | default([]) %}
    pre-down iptables -D INPUT -i {{ iface.name }} -s {{ ip }} -j ACCEPT || true
    pre-down iptables -D OUTPUT -o {{ iface.name }} -d {{ ip }} -j ACCEPT || true
{% endfor %}
    pre-down iptables -D INPUT -i {{ iface.name }} -m state --state ESTABLISHED,RELATED -j ACCEPT || true
    pre-down iptables -D OUTPUT -o {{ iface.name }} -m state --state ESTABLISHED,RELATED -j ACCEPT || true
    pre-down iptables -D INPUT -i {{ iface.name }} -j DROP || true
    pre-down iptables -D OUTPUT -o {{ iface.name }} -j DROP || true
{% endif %}

{% endfor -%}
