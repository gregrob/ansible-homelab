# Managed by Ansible - do not edit by hand
#
# Network UPS Tools: upsmon.conf
# This file configures the UPS monitoring daemon (upsmon)
# Keep this file secure - it contains passwords!

# =======================================================================
# Security Settings
# =======================================================================
RUN_AS_USER {{ nut_server_run_as_user }}

# =======================================================================
# UPS Monitoring Configuration
# =======================================================================
# Format: MONITOR <ups>@<host> <powervalue> <username> <password> <type>
# - <ups>: UPS name from ups.conf
# - localhost: This server (UPS server)
# - 1: Number of power supplies this UPS feeds
# - {{ nut_server_admin_user }}: Username from upsd.users with master privileges
# - master: This system is the primary/master (has shutdown authority)
{% for ups in nut_server_ups %}
MONITOR {{ ups.name }}@localhost 1 {{ nut_server_admin_user }} {{ nut_server_admin_password }} master
{% endfor %}

# =======================================================================
# System Settings
# =======================================================================
{{ '%-37s' | format('MINSUPPLIES ' ~ nut_server_minsupplies) }}# Minimum UPS supplies needed
{{ '%-37s' | format('SHUTDOWNCMD "' ~ nut_server_shutdowncmd ~ '"') }}# Immediate system shutdown command
{{ '%-37s' | format('POWERDOWNFLAG ' ~ nut_server_powerdownflag) }}# Signal file for UPS power-off

# =======================================================================
# Timing Configuration
# =======================================================================
{{ '%-26s' | format('FINALDELAY ' ~ nut_server_finaldelay) }}# Wait {{ nut_server_finaldelay }} seconds before final shutdown
{{ '%-26s' | format('HOSTSYNC ' ~ nut_server_hostsync) }}# Wait {{ nut_server_hostsync }} seconds for secondary acknowledgment
{{ '%-26s' | format('DEADTIME ' ~ nut_server_deadtime) }}# Mark UPS dead after {{ nut_server_deadtime }} seconds of no communication
{{ '%-26s' | format('POLLFREQ ' ~ nut_server_pollfreq) }}# Poll UPS every {{ nut_server_pollfreq }} seconds
{{ '%-26s' | format('POLLFREQALERT ' ~ nut_server_pollfreqalert) }}# Poll UPS every {{ nut_server_pollfreqalert }} second(s) during alerts

# =======================================================================
# Warning Timing Settings
# =======================================================================
{{ '%-26s' | format('RBWARNTIME ' ~ nut_server_rbwarntime) }}# Warn about battery replacement every {{ (nut_server_rbwarntime / 3600) | round(1) | string | replace('.0', '') }} hours
{{ '%-26s' | format('NOCOMMWARNTIME ' ~ nut_server_nocommwarntime) }}# Warn about lost communication every {{ (nut_server_nocommwarntime / 60) | round(1) | string | replace('.0', '') }} minutes

# =======================================================================
# Notification System
# =======================================================================
{% if nut_server_notifycmd | length > 0 %}
{{ '%-32s' | format('NOTIFYCMD ' ~ nut_server_notifycmd) }}# Command for notification scheduling
{% endif %}

# Custom notification messages
{% for event, msg in nut_server_notifymsg.items() %}
{{ 'NOTIFYMSG %-10s "%s"' | format(event, msg) }}
{% endfor %}

# Notification delivery methods:
# - SYSLOG: Log to system log
# - WALL: Display message to all logged-in users
# - EXEC: Execute NOTIFYCMD script for custom actions (emails, alerts, etc.)
{% for n in nut_server_notifyflags %}
{{ 'NOTIFYFLAG %-10s %-19s # %s' | format(n.event, n.flags, n.comment) }}
{% endfor %}
