# Managed by Ansible - do not edit by hand
#
# NUT operating mode for this host. Read by the NUT init/systemd units to
# decide which services to start; it does not configure the services
# themselves (see ups.conf, upsd.conf, upsd.users, upsmon.conf for that).
#
# Valid modes:
#  - none:       NUT is not configured; no services start.
#  - standalone: UPS is attached to this host and only this host uses it.
#                upsd listens on localhost only.
#  - netserver:  UPS is attached to this host AND remote clients connect to
#                it. Same as standalone, but upsd is expected to listen on
#                the network (see nut_server_listen).
#  - netclient:  UPS is attached to another host; only upsmon runs here.
#
# This role is the server side, so nut_server_mode is normally 'netserver'.
# Use 'standalone' only if no other host should ever read this UPS.

MODE={{ nut_server_mode }}
